#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
struct mark{
    int math;
    int science;
    int english;
    int computer;
};
struct student {
    int roll;
    char name[50];
    struct mark m;
    int total;
    
};


int main() { int n;
            scanf("%d",&n);
            int mt=-1;
            int ti=-1;
            struct student s[n];
            for(int i=0;i<n;i++)
            { scanf("%d",&s[i].roll);
                scanf("%s",s[i].name);
                scanf("%d",&s[i].m.math);
                scanf("%d",&s[i].m.science);
                scanf("%d",&s[i].m.english);
                scanf("%d",&s[i].m.computer);
                
s[i].total=s[i].m.math+s[i].m.science+s[i].m.english+s[i].m.computer;
                if(s[i].total>=mt){
                    mt=s[i].total;
                    ti=i;}}
            
            
            printf("Topper Details:\n");
            printf("Roll No: %d\n",s[ti].roll);
            printf("Name: %s\n",s[ti].name);
            printf("Total Marks: %d",s[ti].total);

    return 0;
}
