#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
struct student {
    char name[49];
    int age;
    char grade;
    
};
int main() {
struct student s;
    fgets(s.name,sizeof(s.name),stdin);
    s.name[strcspn(s.name,"\n")]='\0';
    scanf("%d",&s.age);
    scanf(" %c",&s.grade);
    
    printf("Name: %s\n",s.name);
    printf("Age: %d\n",s.age);
    printf("Grade: %c\n",s.grade);
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */    
    return 0;
}
