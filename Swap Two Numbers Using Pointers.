#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
void swap(int *x,int *y){
    int temp=*x;
    *x=*y;
    *y=temp;
}
int main() {int a,b;
            scanf("%d %d",&a,&b);
            swap(&a,&b);
            printf("%d %d",a,b);

