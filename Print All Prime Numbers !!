#include <stdio.h>

// Function to check prime number
int isPrime(int n) {
    if (n <= 1)
        return 0;

    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0)
            return 0;
    }
    return 1;
}

int main() {
    int start, end;
    int found = 0;

    // Read range
    scanf("%d %d", &start, &end);

    // Print prime numbers in range
    for (int i = start; i <= end; i++) {
        if (isPrime(i)) {
            printf("%d ", i);
            found = 1;
        }
    }

    // If no prime numbers found
    if (!found) {
        printf("No prime numbers found");
    }

    return 0;
}

